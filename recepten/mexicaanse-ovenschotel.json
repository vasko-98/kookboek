  "stappen": [
    "Verwarm de oven voor op 200 °C. Snijd de groenten.",
    "Bak het gehakt rul in de olie. Voeg ui en knoflook toe en bak 2 min mee.",
    "Voeg zoete aardappel, paprika en courgette toe en bak 3 min.",
    "Bij saus A: roer eerst de kruiden erdoor (1 min), giet dan passata, tomatenpuree en water erbij. Bij saus B: giet de salsa erbij met een scheutje water.",
    "Laat afgedekt 12 min sudderen tot de zoete aardappel bijna gaar is.",
    "Roer mais en bonen erdoor en verwarm 2 min. Breng op smaak met zout en peper.",
    "Schep alles in een ovenschaal, verdeel de nacho's erover en strooi de kaas erop.",
    "Bak 10–12 min tot de kaas gesmolten is. Laat 3 min rusten en serveer met zure room en koriander."
  ],
  "tips": [
    "Kies saus A of B, niet allebei.",
    "Vegetarisch: vervang het gehakt door extra bonen en mais. Pittiger: jalapeño's of chipotle erbij.",
    "Pas op dat de nacho's niet verbranden."
